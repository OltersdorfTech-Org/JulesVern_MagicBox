[Unit]
Description=Magic Lid web UI (Flask)
After=network-online.target local-fs.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/julesvern
ExecStart=/opt/julesvern/venv/bin/python /opt/julesvern/src/web_server.py --port 8080
Restart=on-failure
RestartSec=2
User=julesvern
Group=julesvern
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1
Environment=MAGICBOX_DATA_DIR=/var/lib/julesvern
Environment=MAGICBOX_STATE_DIR=/var/lib/julesvern/state
Environment=MAGICBOX_LOG_DIR=/var/log/julesverne_magicbox
SupplementaryGroups=gpio

[Install]
WantedBy=multi-user.target
