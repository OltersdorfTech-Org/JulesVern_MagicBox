[Unit]
Description=Magic Box status LED daemon
After=network-online.target local-fs.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/julesverne_magicbox/runtime.conf
User=${JV_USER}
Group=${JV_USER}
WorkingDirectory=${JV_REPO_DIR}
ExecStart=/usr/bin/python3 ${JV_REPO_DIR}/src/hardware/status_led_daemon.py
Restart=always
RestartSec=2
TimeoutStopSec=15
Environment=PYTHONUNBUFFERED=1
SupplementaryGroups=gpio
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
